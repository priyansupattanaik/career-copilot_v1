# One repository-wide environment file.
# Copy this file to .env. Keep real credentials only in the ignored .env file.

# Frontend and API
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_NAME=Career Copilot API
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Local persistence
DATABASE_PATH=./.data/career-copilot.sqlite
LOCAL_STORAGE_DIR=./.data/storage
AUTH_SECRET=replace-with-a-long-random-local-secret
DOCUMENT_BUCKET=documents
AVATAR_BUCKET=avatars
INTERVIEW_BUCKET=interview-media

# File limits and signed local URLs
DOCUMENT_MAX_BYTES=10485760
AVATAR_MAX_BYTES=5242880
INTERVIEW_MEDIA_MAX_BYTES=52428800
EXPORT_SIGNED_URL_SECONDS=900

# Provider selection: groq or nvidia
LLM_PROVIDER=groq

# NVIDIA provider (server-only; leave the key empty when unused)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-3.2
NVIDIA_TIMEOUT_SECONDS=45
NVIDIA_MAX_RETRIES=2
NVIDIA_MAX_OUTPUT_TOKENS=1200
NVIDIA_TEMPERATURE=0.1
NVIDIA_PROMPT_VERSION=v1

# Groq provider (server-only; leave the key empty when unused)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=2
GROQ_MAX_OUTPUT_TOKENS=1200
GROQ_TEMPERATURE=0.1

# Resume improvement limits
IMPROVEMENT_MAX_SECTIONS=8
IMPROVEMENT_MAX_SOURCE_CHARS=24000
IMPROVEMENT_MAX_JD_CHARS=12000
